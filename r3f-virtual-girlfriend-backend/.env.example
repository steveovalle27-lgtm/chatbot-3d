# ============================================================
# .env.example — Template de variables de entorno
# ============================================================
# Cómo usar:
#   1. Copia este archivo: cp .env.example .env
#   2. Reemplaza los valores con tus claves reales
#   3. NUNCA subas .env al repositorio
# ============================================================

# ─── Groq API (gratis: https://console.groq.com/keys) ───
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase (https://supabase.com/dashboard) ───
SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── ElevenLabs (OPCIONAL — https://elevenlabs.io) ───
# Si no tienes, déjalo vacío y el sistema usará Edge TTS gratis
ELEVEN_LABS_API_KEY=

# ─── Configuración del servidor ───
PORT=3000
NODE_ENV=development
