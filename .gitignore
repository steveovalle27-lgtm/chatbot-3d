# ============================================================
# .gitignore — Chatbot Avatar 3D
# ============================================================

# ─── 🔒 SECRETOS Y CREDENCIALES (CRÍTICO — nunca subir) ───
.env
.env.local
.env.*.local
*.env
*.pem
*.key
secrets.json
credentials.json

# Mantener templates de ejemplo
!.env.example
!*.env.example

# ─── 📦 Dependencias Node.js ───
node_modules/
*/node_modules/
**/node_modules/
jspm_packages/
bower_components/

# ─── 📋 Logs ───
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── 🎵 Archivos generados en runtime ───
audios/*.mp3
audios/*.wav
audios/*.json
!audios/.gitkeep
!audios/intro_*.wav
!audios/intro_*.json

# ─── 🧪 Testing y cobertura ───
coverage/
.nyc_output/
*.lcov
TestResults/
**/TestResults/

# ─── 🏗️ Build outputs ───
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# ─── 🎯 .NET / Visual Studio ───
bin/
obj/
!**/bin/rhubarb.exe
!**/bin/rhubarb
!**/bin/res/
*.suo
*.user
*.userosscache
*.sln.docstates
[Dd]ebug/
[Rr]elease/
x64/
x86/
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ─── 💻 OS ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── ✏️ Editores ───
*.swp
*.swo
*~
*.bak
.idea/
*.iml

# ─── 🚀 Vite / React ───
.vite/

# ─── 🐳 Docker ───
.docker/

# ─── 📦 Paquetes locales ───
*.tgz
*.zip
*.tar.gz
package-lock.json.backup

# ─── ⚙️ Configuraciones locales ───
.env.development.local
.env.test.local
.env.production.local
config.local.*

# ─── 📊 Reportes ───
report.html
report.json
reports/

# ─── 🔧 Misc ───
*.tmp
*.temp
.tmp/
.temp/
